<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>local.ai-accounts.keepawake</string>

  <!-- Keep the Mac from idle-sleeping so the usage dashboard stays reachable
       (http://<hostname>.local:8787). -i = no idle sleep (also on battery);
       -s = no system sleep (AC power only). The display may still turn off.
       Stop it with:  launchctl bootout gui/$(id -u)/local.ai-accounts.keepawake -->
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/caffeinate</string>
    <string>-i</string>
    <string>-s</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>
</dict>
</plist>
