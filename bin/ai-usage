  const add = $("addbtn"); if (add) add.onclick = addAccount;
  const modal = $("modal");
  if (modal) modal.onclick = e => { if (e.target === modal) openModal(false); };
}

render();
wireUI();

async function tick() {
  try {
    const r = await fetch("data.json", {cache:"no-store"});
    const j = await r.json();
    DATA = j.rows; META = j.meta;
  } catch (e) { /* server gone; keep the last good numbers */ }
  render();
}

if (META.live) {
  setInterval(tick, (META.interval || 10) * 1000);
  // Countdowns are derived from timestamps we already hold, so they can stay
  // current without costing an API call.
  setInterval(render, 10000);
}
</script></body></html>"""


# ---- quota limits ---------------------------------------------------------
# These are the SAME numbers Claude Code's /usage and Codex's status show, read
# out of local state. Both are CACHES written by the CLI: they are only as fresh
# as the last time that account actually ran, so every reading carries an age.

def _iso_epoch(v):
    """Accept either an epoch int or an ISO-8601 string."""
    if v is None:
        return None
    if isinstance(v, (int, float)):
        return float(v)
    try:
        import datetime
        return datetime.datetime.fromisoformat(str(v).replace("Z", "+00:00")).timestamp()
    except Exception:
        return None


# ---- live quota via the OAuth usage endpoint ------------------------------
# Claude Code reads /api/oauth/usage with the account's own bearer token. Holding
# one token per account lets every account be polled live and simultaneously,
# which the shared macOS Keychain otherwise prevents.
USAGE_URL = "https://api.anthropic.com/api/oauth/usage"


def token_path(d):
    return os.path.join(d, "token.json")


def read_token(d):
    try:
        with open(token_path(d)) as fh:
            return json.load(fh)
    except Exception:
        return None


def write_token(d, blob):
    p = token_path(d)
    fd = os.open(p, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w") as fh:
        json.dump(blob, fh)
    os.chmod(p, 0o600)
    return p


TOKEN_URL = "https://api.anthropic.com/v1/oauth/token"
CLIENT_ID = "9d1c250a-e61b-44d9-88ed-5944d1962f5e"
REFRESH_MARGIN = 900   # refresh when under 15 minutes remain


def keychain_write(config_dir, blob):
    """Write the credential back into the SAME item the CLI reads, so the CLI
    and this tool never diverge. The secret goes in over stdin, not argv."""
    svc = keychain_service(config_dir)
    # keychain_token() hands back the INNER object; the CLI stores it wrapped as
    # {"claudeAiOauth": {...}}. Writing the inner object raw leaves a valid token
    # the CLI cannot find, and it reports "not logged in".
    payload = json.dumps({"claudeAiOauth": blob})
    try:
        # The value must be passed as an argument: `-w` with no value prompts
        # interactively and, when fed a pipe, silently stores an EMPTY secret.
        r = subprocess.run(
            ["security", "add-generic-password", "-U", "-s", svc,
             "-a", os.environ.get("USER") or "", "-w", payload],
            capture_output=True, text=True, timeout=30)
        if r.returncode != 0:
            return False
        back = subprocess.run(
            ["security", "find-generic-password", "-s", svc, "-w"],
            capture_output=True, text=True, timeout=30)
        # Never trust the write: read it back before reporting success.
        if back.returncode != 0 or back.stdout.strip() != payload:
            return False
        # and prove the envelope survived, not just the bytes
        try:
            return bool((json.loads(back.stdout).get("claudeAiOauth") or {}).get("accessToken"))
        except Exception:
            return False
    except Exception:
        return False


def refresh_token(config_dir, blob):
    """Exchange the refresh token for a new pair. Returns (blob, error)."""
    import urllib.request, urllib.error, time
    rt = (blob or {}).get("refreshToken")
    if not rt:
        return None, "no refresh token"
    body = json.dumps({"grant_type": "refresh_token",
                       "refresh_token": rt, "client_id": CLIENT_ID}).encode()
    req = urllib.request.Request(TOKEN_URL, data=body, headers={
        "Content-Type": "application/json", "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            doc = json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        return None, "HTTP %d" % e.code
    except Exception as e:
        return None, str(e)[:50]
    access = doc.get("access_token")
    if not access:
        return None, "no access_token in response"
    fresh = dict(blob)
    fresh["accessToken"] = access
    if doc.get("refresh_token"):
        fresh["refreshToken"] = doc["refresh_token"]
    if doc.get("expires_in"):
        fresh["expiresAt"] = int((time.time() + float(doc["expires_in"])) * 1000)
    # Each refresh issues a NEW refresh token with a fresh 28-day window. Record
    # it, or the stored expiry silently keeps the original login's deadline and
    # the credential looks like it is about to die when it is not.
    if doc.get("refresh_token_expires_in"):
        fresh["refreshTokenExpiresAt"] = int(
            (time.time() + float(doc["refresh_token_expires_in"])) * 1000)
    if isinstance(doc.get("scope"), str):
        fresh["scopes"] = doc["scope"].split()
    return fresh, None


def token_for(config_dir):
    """The credential to use now, refreshed first if it is about to expire."""
    import time
    blob = keychain_token(config_dir)
    if not blob:
        return None, "not signed in"
    exp = (blob.get("expiresAt") or 0) / 1000.0
    if exp and exp - time.time() > REFRESH_MARGIN:
        return blob, None
    fresh, err = refresh_token(config_dir, blob)
    if not fresh:
        return blob, "refresh failed: %s" % err
    keychain_write(config_dir, fresh)
    return fresh, None


def keychain_service(config_dir=None):
    """Claude Code scopes each config dir to its OWN Keychain item, named
    "Claude Code-credentials-<sha256(dir)[:8]>". The default ~/.claude uses the
    bare name. This is what lets several accounts be signed in at once."""
    import hashlib
    if not config_dir:
        return "Claude Code-credentials"
    real = os.path.realpath(os.path.expanduser(config_dir))
    if real == os.path.realpath(os.path.expanduser("~/.claude")):
        return "Claude Code-credentials"
    return "Claude Code-credentials-%s" % hashlib.sha256(real.encode()).hexdigest()[:8]


def keychain_token(config_dir=None):
    """Read that config dir's own credential. No token ever leaves the Keychain."""
    try:
        r = subprocess.run(["security", "find-generic-password",
                            "-s", keychain_service(config_dir), "-w"],
                           capture_output=True, text=True, timeout=30)
        if r.returncode != 0:
            return None
        return (json.loads(r.stdout).get("claudeAiOauth") or {}) or None
    except Exception:
        return None


def live_claude_usage(blob):
    """Returns (windows, error). Never raises."""
    import urllib.request, urllib.error
    tok = (blob or {}).get("accessToken")
    if not tok:
        return None, "no token"
    req = urllib.request.Request(USAGE_URL, headers={
        "Authorization": "Bearer " + tok,
        "anthropic-beta": "oauth-2025-04-20",
        "Accept": "application/json",
    })
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            doc = json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        if e.code == 429:
            # Anthropic states the penalty; retrying inside it just extends it.
            ra = e.headers.get("retry-after") if e.headers else None
            try:
                ra = int(float(ra)) if ra else 0
            except ValueError:
                ra = 0
            return None, "Rate Limit|%d" % ra
        if e.code in (401, 403):
            # A 403 can be the ORG refusing OAuth, not an expired token; read
            # the body so the row says which, since the fixes are different.
            try:
                body = json.loads(e.read().decode())
                msg = ((body.get("error") or {}).get("message") or "")
            except Exception:
                msg = ""
            if "not allowed for this organization" in msg:
                return None, "Blocked by organization"
            return None, "token expired \u2014 re-login"
        return None, "HTTP %d" % e.code
    except Exception as e:
        return None, str(e)[:40]

    u = doc.get("utilization") or doc
    wins = []
    for e in (u.get("limits") or []):
        pct = e.get("percent")
        if pct is None:
            continue
        kind = e.get("kind")
        if kind == "session":
            label = "Session (5hr)"
        elif kind == "weekly_all":
            label = "Weekly (7 day)"
        elif kind == "weekly_scoped":
            m = ((e.get("scope") or {}).get("model") or {}).get("display_name")
            label = "Weekly %s" % (m or "scoped")
        else:
            label = str(kind or "window")
        wins.append({"label": label, "kind": kind, "pct": pct,
                     "left": max(0, 100 - pct),
                     "resets": _iso_epoch(e.get("resets_at")),
                     "severity": e.get("severity"),
                     "active": bool(e.get("is_active")), "live": True})
    return (wins or None), None


PROFILE_URL = "https://api.anthropic.com/api/oauth/profile"

# Profile name -> the account it must hold. An empty profile would otherwise
# accept ANY token, which is how a slot silently ends up mislabelled.
EXPECT = {}


# The page can re-render every few seconds for free, but each account may only
# be polled so often before the API answers 429. These are decoupled: the cache
# below is what the page reads, and it refills on its own schedule.
MIN_POLL_SECONDS = 120   # 2 minutes per account
BACKOFF_SECONDS = 300
_usage_cache = {}   # dir -> {"windows", "at", "next_ok", "stale_reason"}


CACHE_FILE = os.path.join(ROOT, ".usage-cache.json")


def _cache_load():
    """Survive restarts: without this, every restart re-polls every account at
    once, which is what trips the rate limit."""
    try:
        with open(CACHE_FILE) as fh:
            for k, v in (json.load(fh) or {}).items():
                if isinstance(v, dict) and v.get("windows"):
                    _usage_cache[k] = {"windows": v["windows"], "at": v.get("at"),
                                       "next_ok": 0, "stale_reason": None}
    except Exception:
        pass


def _cache_save():
    try:
        tmp = CACHE_FILE + ".tmp"
        with open(tmp, "w") as fh:
            json.dump({k: {"windows": v.get("windows"), "at": v.get("at")}
                       for k, v in _usage_cache.items() if v.get("windows")}, fh)
        os.replace(tmp, CACHE_FILE)
    except Exception:
        pass


def cached_usage(d, blob):
    """Poll at most every MIN_POLL_SECONDS per account; on 429 back off and keep
    serving the last good reading rather than pretending there is no data."""
    import time
    now = time.time()
    ent = _usage_cache.get(d)
    if ent and now < ent.get("next_ok", 0):
        return ent["windows"], ent["at"], ent.get("stale_reason")

    wins, err = live_claude_usage(blob)
    if wins:
        _usage_cache[d] = {"windows": wins, "at": now,
                           "next_ok": now + MIN_POLL_SECONDS, "stale_reason": None}
        _cache_save()
        return wins, now, None

    reason = err or "fetch failed"
    wait = MIN_POLL_SECONDS
    if str(err).startswith("Rate Limit"):
        ra = 0
        if "|" in str(err):
            try:
                ra = int(str(err).split("|", 1)[1])
            except ValueError:
                ra = 0
        # honour the server's retry-after (+ a margin); never shorter than our floor
        wait = max(BACKOFF_SECONDS, ra + 60)
        reason = "Rate Limit" + (" \u00b7 retry in %dm" % max(1, wait // 60))
    if ent and ent.get("windows"):
        ent["next_ok"] = now + wait
        ent["stale_reason"] = reason
        return ent["windows"], ent["at"], reason
    _usage_cache[d] = {"windows": None, "at": None,
                       "next_ok": now + wait, "stale_reason": reason}
    return None, None, reason


def token_owner(blob):
    """Ask the API whose token this is. Sequence is not proof \u2014 a browser
    session can authorize a different account than the one requested."""
    import urllib.request, urllib.error
    tok = (blob or {}).get("accessToken")
    if not tok:
        return None, "no token"
    req = urllib.request.Request(PROFILE_URL, headers={
        "Authorization": "Bearer " + tok,
        "anthropic-beta": "oauth-2025-04-20", "Accept": "application/json"})
    try:
        with urllib.request.urlopen(req, timeout=30) as r:
            d = json.loads(r.read().decode())
    except urllib.error.HTTPError as e:
        return None, "HTTP %d" % e.code
    except Exception as e:
        return None, str(e)[:40]
    acct = d.get("account") or {}
    org = d.get("organization") or {}
    return {"email": acct.get("email"), "uuid": acct.get("uuid"),
            "tier": org.get("rate_limit_tier"),
            "plan": org.get("organization_type")}, None


def capture(account):
    """Copy the credential the CLI just wrote into that account's own store."""
    d = os.path.join(ROOT, "claude", account)
    if not os.path.isdir(d):
        print("no such profile: %s" % d, file=sys.stderr)
        return 2
    blob = keychain_token(d)
    if not blob:
        print("no credential in the Keychain \u2014 sign in first", file=sys.stderr)
        return 1
    who, err = token_owner(blob)
    if not who:
        print("could not identify the token: %s" % err, file=sys.stderr)
        return 1
    expected = claude_identity(d) or EXPECT.get(account)
    if not expected:
        print("refusing: profile '%s' has no known account, so any token would "
              "be accepted." % account, file=sys.stderr)
        print("  Re-run with the account it belongs to:", file=sys.stderr)
        print("    ai-usage --capture %s --expect <email>" % account, file=sys.stderr)
        return 1
    if who["email"] and expected != who["email"]:
        print("\u26a0 MISMATCH: profile '%s' expects %s but the Keychain token "
              "belongs to %s" % (account, expected, who["email"]), file=sys.stderr)
        print("  Not capturing. Sign in as %s (private window) and retry."
              % expected, file=sys.stderr)
        return 1
    blob = dict(blob)
    blob["capturedEmail"] = who["email"]
    blob["capturedUuid"] = who["uuid"]
    blob["rateLimitTier"] = who["tier"]
    path = write_token(d, blob)
    print("captured %s \u2192 %s (mode 600)" % (who["email"], path.replace(os.path.expanduser("~"), "~")))
    print("  plan: %s / %s" % (who["plan"], who["tier"]))
    return 0


def claude_limits(d):
    cfg = os.path.join(d, ".claude.json")
    if not os.path.exists(cfg) and os.path.realpath(d) == os.path.realpath(
            os.path.expanduser("~/.claude")):
        cfg = os.path.expanduser("~/.claude.json")
    try:
        with open(cfg) as fh:
            cached = json.load(fh).get("cachedUsageUtilization") or {}
    except Exception:
        return None
    u = cached.get("utilization") or {}
    if not u:
        return None

    wins = []
    # `limits` is what Claude Code's own Account & Usage panel renders: every
    # window including model-scoped ones, each with its own severity.
    for e in (u.get("limits") or []):
        pct = e.get("percent")
        if pct is None:
            continue
        kind = e.get("kind")
        if kind == "session":
            label = "Session (5hr)"
        elif kind == "weekly_all":
            label = "Weekly (7 day)"
        elif kind == "weekly_scoped":
            model = ((e.get("scope") or {}).get("model") or {}).get("display_name")
            label = "Weekly %s" % (model or "scoped")
        else:
            label = str(kind or "window")
        wins.append({"label": label, "kind": kind, "pct": pct,
                     "left": max(0, 100 - pct),
                     "resets": _iso_epoch(e.get("resets_at")),
                     "severity": e.get("severity"),
                     "active": bool(e.get("is_active"))})

    if not wins:  # older payloads without the limits array
        for key, label in (("five_hour", "Session (5hr)"), ("seven_day", "Weekly (7 day)")):
            w = u.get(key) or {}
            pct = w.get("utilization")
            if pct is None:
                continue
            wins.append({"label": label, "kind": key, "pct": pct,
                         "left": max(0, 100 - pct),
                         "resets": _iso_epoch(w.get("resets_at")),
                         "severity": None, "active": False})

    if not wins:
        return None
    return {"windows": wins,
            "as_of": (cached.get("fetchedAtMs") or 0) / 1000.0 or None,
            "plan": None, "credits": None,
            "account": cached.get("accountUuid")}


def codex_limits(d):
    """Newest rollout wins; scan its token_count events backwards for the last
    one whose windows are populated (many carry rate_limits with null windows)."""
    import re
    sess = os.path.join(d, "sessions")
    if not os.path.isdir(sess):
        return None
    files = []
    for root, _dirs, names in os.walk(sess):
        for n in names:
            if n.endswith(".jsonl"):
                fp = os.path.join(root, n)
                try:
                    files.append((os.path.getmtime(fp), fp))
                except OSError:
                    pass
    files.sort(reverse=True)
    pat = re.compile(r'"rate_limits":\{.*?"primary":\{(.*?)\}.*?"secondary":(\{.*?\}|null)')
    for _mt, fp in files[:6]:
        try:
            with open(fp, errors="replace") as fh:
                lines = fh.readlines()
        except OSError:
            continue
        for line in reversed(lines):
            if '"rate_limits"' not in line or '"primary":{' not in line:
                continue
            try:
                obj = json.loads(line)
            except Exception:
                continue
            info = (obj.get("payload") or {})
            rl = info.get("rate_limits") or (info.get("info") or {}).get("rate_limits")
            if not rl or not rl.get("primary"):
                continue
            prim, sec = rl.get("primary") or {}, rl.get("secondary") or {}
            # window_minutes tells us which window is which: 300 = 5h, 10080 = 7d
            windows = {}
            for w in (prim, sec):
                if not w:
                    continue
                mins = w.get("window_minutes")
                key = "five_hour" if mins and mins <= 600 else "weekly"
                pct = w.get("used_percent")
                windows[key] = {"pct": pct,
                                "left": None if pct is None else max(0.0, 100.0 - pct),
                                "resets": _iso_epoch(w.get("resets_at"))}
            creds = rl.get("credits") or {}
            wins = []
            for key, label in (("five_hour", "Session (5hr)"), ("weekly", "Weekly (7 day)")):
                w = windows.get(key)
                if not w or w.get("pct") is None:
                    continue
                wins.append({"label": label, "kind": key, "pct": w["pct"],
                             "left": w["left"], "resets": w["resets"],
                             "severity": None, "active": False})
            if not wins:
                continue
            return {
                "windows": wins,
                "as_of": _iso_epoch(obj.get("timestamp")) or os.path.getmtime(fp),
                "plan": rl.get("plan_type"),
                "credits": (None if not creds.get("has_credits") and creds.get("balance") in (None, "0")
                            else {"balance": creds.get("balance"),
                                  "unlimited": bool(creds.get("unlimited"))}),
                "account": None,
            }
    return None


def last_activity(tool, d):
    """Newest session-file mtime in a profile — when that account last ran."""
    probe = os.path.join(d, "projects" if tool == "claude" else "sessions")
    newest = None
    for root, _dirs, files in os.walk(probe):
        for f in files:
            if not f.endswith(".jsonl"):
                continue
            try:
                m = os.path.getmtime(os.path.join(root, f))
            except OSError:
                continue
            if newest is None or m > newest:
                newest = m
    return newest


def infer_reset(lim, tool, d):
    """An idle account only recovers: if a window's reset time has passed and
    nothing ran under that account since, the allowance is back. A deduction,
    so it is labelled."""
    import time
    if not lim:
        return lim
    act = last_activity(tool, d)
    now = time.time()
    for w in lim.get("windows") or []:
        r = w.get("resets")
        if not r or r > now:
            continue
        if act is None or act <= r:
            w["pct"], w["left"] = 0, 100
            w["inferred"] = "window reset, no activity since"
        else:
            w["inferred"] = "stale \u2014 account ran after this reading"
    return lim


def codex_limit_error(d):
    """When a Codex account is exhausted the request is rejected BEFORE any
    usage is computed, so rate_limits comes back null. The refusal text is then
    the only record of the state, and it carries the reset time."""
    import re, datetime
    sess = os.path.join(d, "sessions")
    if not os.path.isdir(sess):
        return None
    files = []
    for root, _dirs, names in os.walk(sess):
        for n in names:
            if n.endswith(".jsonl"):
                fp = os.path.join(root, n)
                try:
                    files.append((os.path.getmtime(fp), fp))
                except OSError:
                    pass
    files.sort(reverse=True)
    for mt, fp in files[:4]:
        try:
            with open(fp, errors="replace") as fh:
                lines = fh.readlines()
        except OSError:
            continue
        for line in reversed(lines):
            if "usage limit" not in line:
                continue
            m = re.search(r"try again at ([A-Z][a-z]{2} \d{1,2})[a-z]{2}, (\d{4}) "
                          r"(\d{1,2}):(\d{2}) ?([AP]M)", line)
            resets = None
            if m:
                mon_day, year, hh, mm, ap = m.groups()
                hh = int(hh) % 12 + (12 if ap == "PM" else 0)
                try:
                    resets = datetime.datetime.strptime(
                        "%s %s %02d:%s" % (mon_day, year, hh, mm),
                        "%b %d %Y %H:%M").timestamp()
                except ValueError:
                    resets = None
            return {"windows": [{"label": "Usage", "kind": "usage", "pct": 100,
                                 "left": 0, "resets": resets,
                                 "severity": "critical", "active": True,
                                 "note": "limit reached"}],
                    "as_of": mt, "plan": codex_plan(d), "credits": None,
                    "account": None}
    return None


def codex_plan(d):
    try:
        with open(os.path.join(d, "auth.json")) as fh:
            tok = json.load(fh)["tokens"]["id_token"]
        import base64
        payload = tok.split(".")[1]
        payload += "=" * (-len(payload) % 4)
        c = json.loads(base64.urlsafe_b64decode(payload))
        return (c.get("https://api.openai.com/auth") or {}).get("chatgpt_plan_type")
    except Exception:
        return None


def limits_for(tool, d):
    if tool == "claude":
        blob, tok_err = token_for(d)
        if blob:
            wins, at, reason = cached_usage(d, blob)
            if wins:
                return {"windows": wins, "as_of": at, "live": not reason,
                        "error": reason,
                        "plan": blob.get("subscriptionType"), "credits": None,
                        "account": None}
            cached = claude_limits(d)
            if cached:
                cached["error"] = reason
                return infer_reset(cached, tool, d)
            return {"windows": [], "as_of": None, "live": False,
                    "error": reason or "no data", "plan": None,
                    "credits": None, "account": None}
    if tool == "codex":
        # A run that succeeded and a run that was refused are both evidence;
        # whichever happened LAST is the truth. Preferring the one with numbers
        # would show an old healthy percentage for an account now refused.
        ok = codex_limits(d)
        refused = codex_limit_error(d)
        cands = [x for x in (ok, refused) if x and x.get("windows")]
        lim = max(cands, key=lambda x: x.get("as_of") or 0) if cands else (ok or refused)
        return infer_reset(lim, tool, d)
    lim = claude_limits(d)
    return infer_reset(lim, tool, d)


def fmt_age(ts):
    import time
    if not ts:
        return "never"
    sec = max(0, time.time() - ts)
    if sec < 90:
        return "just now"
    if sec < 3600:
        return "%dm ago" % (sec // 60)
    if sec < 86400:
        return "%dh ago" % (sec // 3600)
    return "%dd ago" % (sec // 86400)


def fmt_reset(ts):
    import datetime, time
    if not ts:
        return "-"
    delta = ts - time.time()
    when = datetime.datetime.fromtimestamp(ts)
    if delta <= 0:
        return "elapsed"
    if delta < 86400:
        h, m = int(delta // 3600), int((delta % 3600) // 60)
        return "%s %s" % (when.strftime("%H:%M"), ("+%dh%02dm" % (h, m)) if h else "+%dm" % m)
    return when.strftime("%a %d %b %H:%M")


def gauge(pct, width=12):
    if pct is None:
        return " " * width
    filled = int(round(min(pct, 100) / 100.0 * width))
    return "\u2588" * filled + "\u2591" * (width - filled)


def cli_bin(tool):
    import glob
    pat = ("anthropic.claude-code-*-darwin-*" if tool == "claude"
           else "openai.chatgpt-*-darwin-*")
    dirs = sorted(glob.glob(os.path.expanduser("~/.vscode/extensions/" + pat)))
    if not dirs:
        return None
    tail = ("resources/native-binary/claude" if tool == "claude"
            else "bin/macos-aarch64/codex")
    path = os.path.join(dirs[-1], tail)
    return path if os.path.exists(path) else None


def auth_check():
    """Ask each CLI directly. The config file can show a stale account after a
    credential is clobbered, so only the CLI's own answer is trustworthy."""
    rows = []
    cb, xb = cli_bin("claude"), cli_bin("codex")

    def claude_one(label, cfg):
        if not cb:
            return (label, "claude", "?", "claude CLI not found")
        env = dict(os.environ)
        if cfg:
            env["CLAUDE_CONFIG_DIR"] = cfg
        else:
            env.pop("CLAUDE_CONFIG_DIR", None)
        try:
            r = subprocess.run([cb, "auth", "status"], env=env,
                               capture_output=True, text=True, timeout=120)
            d = json.loads(r.stdout)
            return (label, "claude", d.get("email") or "-",
                    "LOGGED IN" if d.get("loggedIn") else "logged out")
        except Exception as e:
            return (label, "claude", "-", "check failed: %s" % str(e)[:40])

    rows.append(claude_one("DEFAULT (~/.claude)", None))
    base = os.path.join(ROOT, "claude")
    if os.path.isdir(base):
        for n in sorted(os.listdir(base)):
            d = os.path.join(base, n)
            if os.path.isdir(d):
                rows.append(claude_one(n, d))

    base = os.path.join(ROOT, "codex")
    if os.path.isdir(base) and xb:
        for n in sorted(os.listdir(base)):
            d = os.path.join(base, n)
            if not os.path.isdir(d):
                continue
            env = dict(os.environ); env["CODEX_HOME"] = d
            try:
                r = subprocess.run([xb, "login", "status"], env=env,
                                   capture_output=True, text=True, timeout=120)
                out = (r.stdout or r.stderr).strip().splitlines()
                txt = out[0] if out else "?"
                rows.append((n, "codex", codex_identity(d) or "-",
                             "LOGGED IN" if "Logged in" in txt else txt[:30]))
            except Exception as e:
                rows.append((n, "codex", "-", "check failed"))

    print("%-22s %-7s %-34s %s" % ("PROFILE", "TOOL", "ACCOUNT", "LIVE STATUS"))
    print("-" * 84)
    for r in rows:
        print("%-22s %-7s %-34s %s" % r)
    import collections
    pairs = [(r[1], r[2]) for r in rows if r[3] == "LOGGED IN" and r[2] not in ("-", "?")]
    emails = [e for _t, e in pairs]
    # Only a clash WITHIN one tool matters: the same person on Claude and on
    # Codex is two different services, not a mislabelled slot.
    dupes = [e for (t, e), c in collections.Counter(pairs).items() if c > 1]
    print()
    print("  logged in: %d of %d" % (len(emails), len(rows)))
    if dupes:
        print("  \u26a0 SAME ACCOUNT IN TWO PROFILES: %s" % ", ".join(dupes))
    return 0


# ---- account management from the dashboard --------------------------------
_logins = {}          # "tool/name" -> {"proc", "url", "started", "done", "error"}
_logins_lock = None


def _valid_name(n):
    import re
    return bool(re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9_-]{0,31}", n or ""))


def add_profile(tool, name):
    if tool not in ("claude", "codex"):
        return False, "unknown tool"
    if not _valid_name(name):
        return False, "name must be letters, digits, - or _ (max 32)"
    d = os.path.join(ROOT, tool, name)
    if os.path.exists(d):
        return False, "that account already exists"
    try:
        os.makedirs(d, mode=0o700)
    except Exception as e:
        return False, str(e)[:60]
    return True, d


def remove_profile(tool, name):
    """Delete a profile and, for Claude, its Keychain item. Refuses anything
    that does not resolve to a direct child of the accounts folder."""
    import shutil
    if tool not in ("claude", "codex"):
        return False, "unknown tool"
    if not _valid_name(name):
        return False, "bad account name"
    base = os.path.realpath(os.path.join(ROOT, tool))
    d = os.path.realpath(os.path.join(base, name))
    if os.path.dirname(d) != base or not os.path.isdir(d):
        return False, "no such account"

    removed = {"dir": False, "keychain": False}
    if tool == "claude":
        svc = keychain_service(d)
        try:
            r = subprocess.run(["security", "delete-generic-password", "-s", svc],
                               capture_output=True, text=True, timeout=30)
            removed["keychain"] = r.returncode == 0
        except Exception:
            pass
    try:
        shutil.rmtree(d)
        removed["dir"] = not os.path.exists(d)
    except Exception as e:
        return False, str(e)[:60]
    _usage_cache.pop(d, None)
    _logins.pop("%s/%s" % (tool, name), None)
    return True, removed


AUTO_CODEX_SECONDS = 3600  # automatic Codex refresh: once an hour per account
MANUAL_MIN_GAP = 60        # Sync now refreshes immediately; this only absorbs double-clicks
PROBE_PROMPT = "reply with just: ok"
_probe_last = {}           # codex dir -> epoch of last probe


def probe_codex(d, min_gap=MANUAL_MIN_GAP):
    """Codex has no usage endpoint, so the only way to refresh its numbers is to
    make the account run. An exhausted account is refused before any usage is
    counted, so a probe only costs quota when there is quota to spend."""
    import time
    now = time.time()
    last = _probe_last.get(d, 0)
    if now - last < min_gap:
        return {"status": "skipped", "detail": "checked %ds ago" % int(now - last)}
    bin_path = cli_bin("codex")
    if not bin_path:
        return {"status": "error", "detail": "codex CLI not found"}
    if not os.path.exists(os.path.join(d, "auth.json")):
        return {"status": "skipped", "detail": "not signed in"}
    _probe_last[d] = now
    env = dict(os.environ); env["CODEX_HOME"] = d
    try:
        r = subprocess.run([bin_path, "exec", "--skip-git-repo-check", PROBE_PROMPT],
                           env=env, stdin=subprocess.DEVNULL,
                           capture_output=True, text=True, timeout=120)
    except subprocess.TimeoutExpired:
        return {"status": "error", "detail": "timed out"}
    out = (r.stdout or "") + (r.stderr or "")
    if "usage limit" in out:
        return {"status": "limited", "detail": "limit reached"}
    return {"status": "ok" if r.returncode == 0 else "error",
            "detail": "" if r.returncode == 0 else "exit %d" % r.returncode}


def _codex_dirs():
    base = os.path.join(ROOT, "codex")
    if not os.path.isdir(base):
        return []
    return [os.path.join(base, n) for n in sorted(os.listdir(base))
            if os.path.isdir(os.path.join(base, n))]


def sync_codex(min_gap=MANUAL_MIN_GAP):
    dirs = _codex_dirs()
    with cf.ThreadPoolExecutor(max_workers=4) as ex:
        results = list(ex.map(lambda d: probe_codex(d, min_gap), dirs))
    return {os.path.basename(d): res for d, res in zip(dirs, results)}


def codex_due(d):
    """Due when its newest recorded run is 60+ minutes old. Keying on the data's
    real age means a server restart does not spend quota, and a manual Sync
    pushes the next automatic refresh back an hour."""
    import time
    age_data = time.time() - (last_activity("codex", d) or 0)
    age_probe = time.time() - _probe_last.get(d, 0)
    # both must be old: a probe that fails to write a record must not retry every minute
    return age_data >= AUTO_CODEX_SECONDS and age_probe >= AUTO_CODEX_SECONDS


def start_login(tool, name, email=None):
    """Launch the CLI's own OAuth flow and hand the URL back to the page."""
    import threading, time
    key = "%s/%s" % (tool, name)
    d = os.path.join(ROOT, tool, name)
    if not os.path.isdir(d):
        return None, "no such account"
    prev = _logins.get(key)
    if prev and prev.get("proc") and prev["proc"].poll() is None:
        return prev.get("url"), None      # already waiting; reuse its URL

    bin_path = cli_bin(tool)
    if not bin_path:
        return None, "%s CLI not found" % tool
    env = dict(os.environ)
    if tool == "claude":
        env["CLAUDE_CONFIG_DIR"] = d
        cmd = [bin_path, "auth", "login", "--claudeai"]
        if email:
            cmd += ["--email", email]
    else:
        env["CODEX_HOME"] = d
        cmd = [bin_path, "login"]

    try:
        # stdin stays OPEN: Claude's flow can ask for a code to be pasted, which
        # happens whenever the browser does not finish the handshake itself (for
        # example when signing in on another device).
        proc = subprocess.Popen(cmd, env=env, stdin=subprocess.PIPE,
                                stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                                text=True, bufsize=1)
    except Exception as e:
        return None, str(e)[:60]

    ent = {"proc": proc, "url": None, "started": time.time(),
           "done": False, "error": None, "lines": []}
    _logins[key] = ent

    def pump():
        import re
        try:
            for line in proc.stdout:
                ent["lines"].append(line.rstrip())
                if not ent["url"]:
                    m = re.search(r"https://\S*(oauth/authorize|cai/oauth)\S*", line)
                    if m:
                        ent["url"] = m.group(0).rstrip('.,)')
        except Exception:
            pass
        proc.wait()
        ent["done"] = True
        if proc.returncode != 0:
            ent["error"] = "login exited %d" % proc.returncode

    threading.Thread(target=pump, daemon=True).start()
    for _ in range(60):                     # wait briefly for the URL to appear
        if ent["url"] or ent["done"]:
            break
        time.sleep(0.25)
    return ent.get("url"), ent.get("error")


def submit_login_code(tool, name, code):
    """Feed a pasted authorization code to the waiting login process."""
    import re
    key = "%s/%s" % (tool, name)
    ent = _logins.get(key)
    if not ent or not ent.get("proc"):
        return False, "no sign-in is waiting for this account"
    proc = ent["proc"]
    if proc.poll() is not None:
        return False, "that sign-in already finished - start a new one"
    code = (code or "").strip()
    if not code:
        return False, "paste the code first"

    # The code carries the attempt's state after '#'. Checking it here turns a
    # silent failure into a clear message.
    want = re.search(r"state=([^&]+)", ent.get("url") or "")
    got = code.split("#", 1)[1] if "#" in code else None
    if want and got and want.group(1) != got:
        return False, ("that code is from a different sign-in attempt "
                       "(expected ...%s, got ...%s)" % (want.group(1)[-8:], got[-8:]))
    try:
        proc.stdin.write(code + "\n")
        proc.stdin.flush()
    except Exception as e:
        return False, "could not deliver the code: %s" % str(e)[:40]
    return True, "code submitted"


def login_state(tool, name):
    d = os.path.join(ROOT, tool, name)
    key = "%s/%s" % (tool, name)
    ent = _logins.get(key) or {}
    if tool == "claude":
        who = claude_identity(d)
        signed = bool(keychain_token(d))
    else:
        who = codex_identity(d)
        signed = os.path.exists(os.path.join(d, "auth.json"))
    waiting = bool(ent.get("proc") and not ent.get("done"))
    return {"signedIn": signed, "email": who, "url": ent.get("url"),
            "waiting": waiting, "canPasteCode": waiting and bool(ent.get("url")),
            "error": ent.get("error")}


def meta_for(a, live=False, ts=None):
    import datetime
    when = datetime.datetime.fromtimestamp(ts) if ts else datetime.datetime.now()
    return {"period": a.period, "since": a.since or "", "until": a.until or "",
            "generated": when.strftime("%H:%M:%S" if live else "%Y-%m-%d %H:%M"),
            "live": bool(live), "interval": getattr(a, "interval", 60)}


def build_html(rows, meta):
    return HTML.replace("__DATA__", json.dumps(rows)).replace("__META__", json.dumps(meta))


def render_html(rows, path, a):
    path = os.path.expanduser(path)
    with open(path, "w") as fh:
        fh.write(build_html(rows, meta_for(a)))
    return path


def _with_limits(entries, rows):
    for e, r in zip(entries, rows):
        if not isinstance(r, dict):
            continue
        # An excluded account must not leak its quota either — the exclusion is
        # about the account, not merely about its token totals.
        if str(r.get("skipped") or "").startswith("excluded"):
            r["limits"] = None
            continue
        if r.get("limits") is None:
            r["limits"] = limits_for(e[1], e[2])
    return rows


def scan(a):
    entries = discover(a.legacy, a.include_excluded)
    with cf.ThreadPoolExecutor(max_workers=4) as ex:
        rows = list(ex.map(lambda e: run_one(e, a.period, a.since, a.until), entries))
    return _with_limits(entries, rows)


def serve(a, port):
    """Local dashboard that refreshes itself. Bound to loopback only: usage and
    cost figures never leave the machine."""
    import http.server, threading, time
    cache = {"rows": None, "t": 0.0}
    lock = threading.Lock()

    def rows_now(force=False):
        with lock:
            if force:
                # A manual sync clears the poll floor so it actually refetches,
                # but NOT an active 429 backoff - forcing through that is what
                # keeps the limit tripped.
                now_ = time.time()
                for ent in _usage_cache.values():
                    if ent.get("stale_reason") and "Rate Limit" in str(ent["stale_reason"]):
                        continue
                    ent["next_ok"] = 0
            if force or cache["rows"] is None or time.time() - cache["t"] > a.interval:
                cache["rows"] = scan(a)
                cache["t"] = time.time()
            return cache["rows"], cache["t"]

    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass

        def _send(self, body, ctype):
            body = body.encode()
            self.send_response(200)
            self.send_header("Content-Type", ctype)
            self.send_header("Content-Length", str(len(body)))
            self.send_header("Cache-Control", "no-store")
            self.end_headers()
            self.wfile.write(body)

        def do_GET(self):
            if self.path.startswith("/data.json"):
                rows, t = rows_now("force=1" in self.path)
                self._send(json.dumps({"rows": rows, "meta": meta_for(a, True, t)}),
                           "application/json")
            elif self.path in ("/", "/index.html"):
                rows, t = rows_now()
                self._send(build_html(rows, meta_for(a, True, t)), "text/html; charset=utf-8")
            else:
                self.send_error(404)

        def do_POST(self):
            import urllib.parse
            try:
                n = int(self.headers.get("Content-Length") or 0)
                body = json.loads(self.rfile.read(n).decode() or "{}")
            except Exception:
                self._send(json.dumps({"ok": False, "error": "bad request"}),
                           "application/json"); return

            path = urllib.parse.urlparse(self.path).path
            tool = (body.get("tool") or "").strip()
            name = (body.get("name") or "").strip()
            out = {"ok": False, "error": "unknown endpoint"}

            if path == "/api/add":
                ok, res = add_profile(tool, name)
                out = {"ok": ok, "error": None if ok else res,
                       "dir": res if ok else None}
                if ok:
                    cache["rows"] = None          # force a rescan
            elif path == "/api/login":
                url, err = start_login(tool, name, (body.get("email") or "").strip() or None)
                out = {"ok": bool(url) and not err, "url": url, "error": err}
            elif path == "/api/sync":
                if tool not in ("", "claude", "codex"):
                    out = {"ok": False, "error": "unknown tool"}
                else:
                    # Syncing one platform must not spend the other's quota:
                    # Codex probes run only for codex/all, and Claude's poll
                    # floors are cleared only for claude/all.
                    results = sync_codex() if tool in ("", "codex") else {}
                    with lock:
                        cache["rows"] = None
                        if tool in ("", "claude"):
                            for ent in _usage_cache.values():
                                if ent.get("stale_reason") and "Rate Limit" in str(ent["stale_reason"]):
                                    continue
                                ent["next_ok"] = 0
                    out = {"ok": True, "tool": tool or "all", "codex": results}
            elif path == "/api/remove":
                ok, res = remove_profile(tool, name)
                out = {"ok": ok, "error": None if ok else res,
                       "removed": res if ok else None}
                if ok:
                    cache["rows"] = None
            elif path == "/api/login-code":
                ok, msg = submit_login_code(tool, name, body.get("code"))
                out = {"ok": ok, "error": None if ok else msg}
            elif path == "/api/login-state":
                if tool in ("claude", "codex") and _valid_name(name):
                    out = dict(login_state(tool, name)); out["ok"] = True
                    cache["rows"] = None
                else:
                    out = {"ok": False, "error": "bad account"}
            self._send(json.dumps(out), "application/json")

    _cache_load()

    def codex_auto_loop():
        import time
        while True:
            try:
                due = [d for d in _codex_dirs() if codex_due(d)]
                if due:
                    with cf.ThreadPoolExecutor(max_workers=4) as ex:
                        list(ex.map(lambda d: probe_codex(d, AUTO_CODEX_SECONDS), due))
                    with lock:
                        cache["rows"] = None
            except Exception:
                pass
            time.sleep(60)
    threading.Thread(target=codex_auto_loop, daemon=True).start()
    # Stagger the first poll so a restart does not fire every account at once.
    import time as _t
    for i, key in enumerate(sorted(_usage_cache)):
        _usage_cache[key]["next_ok"] = _t.time() + i * 15

    srv = http.server.ThreadingHTTPServer(("127.0.0.1", port), Handler)
    url = "http://127.0.0.1:%d" % port
    print("live dashboard: %s" % url)
    n = len([x for x in (discover(a.legacy, a.include_excluded)) if x[1] == "claude"])
    print("  screen refresh every %ds \u00b7 API poll at most every %ds per account"
          % (a.interval, MIN_POLL_SECONDS))
    print("  \u2248 %.1f API calls/min across %d Claude accounts \u00b7 Ctrl-C to stop"
          % (n * 60.0 / MIN_POLL_SECONDS, n))
    if a.do_open:
        threading.Timer(0.6, lambda: subprocess.run(["open", url], check=False)).start()
    try:
        srv.serve_forever()
    except KeyboardInterrupt:
        print("\nstopped")
    return 0


def main():
    ap = argparse.ArgumentParser(description="Per-account Claude Code + Codex usage")
    ap.add_argument("--period", default="daily", choices=["daily", "weekly", "monthly", "session"])
    ap.add_argument("--since")
    ap.add_argument("--until")
    ap.add_argument("--json", action="store_true", dest="as_json")
    ap.add_argument("--legacy", action="store_true",
                    help="also include the default ~/.claude slot (off by default: it duplicates whichever account is signed into it)")
    ap.add_argument("--include-excluded", action="store_true", help="also count excluded accounts")
    ap.add_argument("--whoami", action="store_true", help="show which account each profile is logged into")
    ap.add_argument("--limits", action="store_true",
                    help="show 5-hour and weekly quota usage per account")
    ap.add_argument("--refresh", metavar="ACCOUNT",
                    help="force a token refresh for that account (test/repair)")
    ap.add_argument("--capture", metavar="ACCOUNT",
                    help="store the Keychain credential into that account's profile")
    ap.add_argument("--expect", metavar="EMAIL",
                    help="the account the captured token MUST belong to")
    ap.add_argument("--auth", action="store_true",
                    help="LIVE auth check per account (asks each CLI, not the config file)")
    ap.add_argument("--html", nargs="?", const=os.path.join(ROOT, "dashboard.html"),
                    help="render a local dashboard (default: ~/.ai-accounts/dashboard.html)")
    ap.add_argument("--open", action="store_true", dest="do_open", help="open the dashboard after writing it")
    ap.add_argument("--serve", nargs="?", const=8787, type=int, metavar="PORT",
                    help="run a live dashboard on 127.0.0.1 (default port 8787)")
    ap.add_argument("--interval", type=int, default=10,
                    help="seconds between screen refreshes (default 10; costs no API calls)")
    ap.add_argument("--poll", type=int, default=MIN_POLL_SECONDS, metavar="SECONDS",
                    help="minimum seconds between API polls PER ACCOUNT (default %d)" % MIN_POLL_SECONDS)
    a = ap.parse_args()

    if a.refresh:
        import time
        d = os.path.join(ROOT, "claude", a.refresh)
        if not os.path.isdir(d):
            print("no such profile: %s" % d, file=sys.stderr); return 2
        before = keychain_token(d)
        if not before:
            print("not signed in", file=sys.stderr); return 1
        who_b, _e = token_owner(before)
        print("  before: %s  expires in %.1f h" % (
            (who_b or {}).get("email"),
            ((before.get("expiresAt") or 0)/1000 - time.time())/3600))
        fresh, err = refresh_token(d, before)
        if not fresh:
            print("  REFRESH FAILED: %s" % err, file=sys.stderr); return 1
        if not keychain_write(d, fresh):
            print("  refreshed but could not write to Keychain", file=sys.stderr); return 1
        who_a, err2 = token_owner(fresh)
        print("  after : %s  expires in %.1f h" % (
            (who_a or {}).get("email") or ("ERROR " + str(err2)),
            ((fresh.get("expiresAt") or 0)/1000 - time.time())/3600))
        print("  refresh token rotated:", before.get("refreshToken") != fresh.get("refreshToken"))
        return 0

    if a.capture:
        if a.expect:
            EXPECT[a.capture] = a.expect
        return capture(a.capture)

    if a.auth:
        return auth_check()

    if a.poll and a.poll != MIN_POLL_SECONDS:
        globals()["MIN_POLL_SECONDS"] = max(15, a.poll)

    if a.serve:
        return serve(a, a.serve)

    entries = discover(a.legacy, a.include_excluded)

    if a.whoami:
        print("%-12s %-7s %-34s %s" % ("ACCOUNT", "TOOL", "LOGGED IN AS", "STATUS"))
        for label, tool, d, email, skip in entries:
            status = skip or ("logged in" if email else "not logged in yet")
            print("%-12s %-7s %-34s %s" % (label, tool, email or "-", status))
        return 0

    if a.limits:
        print("%-12s %-7s %-16s %5s  %-10s %-17s %s" % (
            "ACCOUNT", "TOOL", "WINDOW", "USED", "", "RESETS", "AS OF"))
        print("-" * 96)
        shown = False
        for label, tool, d, email, skip in entries:
            if skip and skip.startswith("excluded"):
                continue
            lim = limits_for(tool, d)
            if not lim or not lim.get("windows"):
                if tool == "codex":
                    signed = os.path.exists(os.path.join(d, "auth.json"))
                else:
                    signed = bool(keychain_token(d))
                msg = ("signed in \u2014 no usage recorded yet (run it once)" if signed
                       else "not signed in yet")
                print("%-12s %-7s %s" % (label, tool, msg))
                continue
            for w in lim["windows"]:
                shown = True
                mark = "*" if str(w.get("inferred", "")).startswith("window reset") else " "
                sev = w.get("severity")
                flag = " !" if sev == "critical" else ""
                print("%-12s %-7s %-16s %4d%%%s %s %-17s %s%s" % (
                    label, tool, w["label"], round(w["pct"]), mark,
                    gauge(w["pct"], 10),
                    "reset" if mark == "*" else fmt_reset(w["resets"]),
                    fmt_age(lim["as_of"]), flag))
        if shown:
            print()
            print("  USED matches Claude Code's Account & Usage panel.")
            print("  'just now' = polled live from the API with that account's own")
            print("  token. An older AS OF means no token stored yet, so the figure")
            print("  comes from a local cache. ! = critical. * = window already reset.")
        return 0

    with cf.ThreadPoolExecutor(max_workers=4) as ex:
        rows = list(ex.map(lambda e: run_one(e, a.period, a.since, a.until), entries))
    rows = _with_limits(entries, rows)

    if a.as_json:
        print(json.dumps({"rows": rows}, indent=2))
        return 0

    if a.html:
        path = render_html(rows, a.html, a)
        print("dashboard written: %s" % path)
        if a.do_open:
            subprocess.run(["open", path], check=False)
        return 0

    active = [r for r in rows if not r.get("skipped")]
    active.sort(key=lambda r: -r.get("cost", 0))
    print("%-12s %-7s %10s %10s %12s" % ("ACCOUNT", "TOOL", "TOKENS", "CACHED", "COST"))
    print("-" * 55)
    for r in active:
        print("%-12s %-7s %10s %10s %12s" % (
            r["label"], r["tool"], human(r["tokens"]), human(r["cacheRead"]),
            "$%.2f" % r["cost"]))
    print("-" * 55)
    print("%-12s %-7s %10s %10s %12s" % (
        "TOTAL", "", human(sum(r["tokens"] for r in active)),
        human(sum(r["cacheRead"] for r in active)),
        "$%.2f" % sum(r["cost"] for r in active)))
    for r in rows:
        if r.get("skipped"):
            print("  skipped %s/%s: %s" % (r["label"], r["tool"], r["skipped"]), file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
