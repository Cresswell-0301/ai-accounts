#!/Users/nexflo/.local/bin/python3.12
"""Per-account Claude Code + Codex usage roll-up.

ccusage aggregates multiple config dirs but merges them into one total with no
per-directory labels. This runs it once per profile dir with the env var pinned
to that dir, so the directory name supplies the account attribution the usage
records themselves never carry.
"""
import argparse, base64, concurrent.futures as cf, json, os, shutil, subprocess, sys

# Overridable so the tool can be exercised against a scratch tree without
# touching the real profiles.
ROOT = os.path.expanduser(os.environ.get("AI_ACCOUNTS_ROOT") or "~/.ai-accounts")

# Keyed on the email, not the directory: the exclusion must follow the account
# even if it is later logged into some other profile dir.
EXCLUDED_EMAILS = {"cresswell.mmu+alt@gmail.com"}

ENV_VAR = {"claude": "CLAUDE_CONFIG_DIR", "codex": "CODEX_HOME"}


def ccusage_cmd():
    if shutil.which("ccusage"):
        return ["ccusage"]
    return ["npx", "-y", "ccusage@latest"]


def claude_identity(d):
    # A profile dir keeps its config INSIDE it, but the default ~/.claude keeps
    # config at ~/.claude.json, one level up. Try both.
    candidates = [os.path.join(d, ".claude.json")]
    if os.path.realpath(d) == os.path.realpath(os.path.expanduser("~/.claude")):
        candidates.append(os.path.expanduser("~/.claude.json"))
    for c in candidates:
        try:
            with open(c) as fh:
                email = (json.load(fh).get("oauthAccount") or {}).get("emailAddress")
            if email:
                return email
        except Exception:
            continue
    return None


def codex_identity(d):
    try:
        with open(os.path.join(d, "auth.json")) as fh:
            tok = json.load(fh)["tokens"]["id_token"]
        payload = tok.split(".")[1]
        payload += "=" * (-len(payload) % 4)
        return json.loads(base64.urlsafe_b64decode(payload)).get("email")
    except Exception:
        return None


def identity(tool, d):
    return claude_identity(d) if tool == "claude" else codex_identity(d)


def discover(include_legacy, include_excluded):
    """Yield (label, tool, dir, email, skip_reason)."""
    out = []
    for tool in ("claude", "codex"):
        base = os.path.join(ROOT, tool)
        if not os.path.isdir(base):
            continue
        for name in sorted(os.listdir(base)):
            d = os.path.join(base, name)
            if not os.path.isdir(d):
                continue
            out.append([name, tool, d, identity(tool, d), None])
    if not os.environ.get("AI_ACCOUNTS_ROOT"):
        # The default ~/.claude slot is whatever account the user's actual
        # project sessions run under. Always show it, labelled "project", so
        # the dashboard follows an account switch instead of missing it - unless
        # that same account already has its own profile row (then it would be
        # a duplicate, which is what the old "legacy" row kept being).
        legacy = os.path.expanduser("~/.claude")
        if os.path.isdir(os.path.join(legacy, "projects")):
            who = claude_identity(legacy)
            known = {r[3] for r in out if r[1] == "claude" and r[3]}
            if who and who not in known:
                out.append(["project", "claude", legacy, who, None])
            elif include_legacy:
                out.append(["legacy", "claude", legacy, who, None])
        if include_legacy:
            old_codex = os.path.expanduser("~/.codex")
            if os.path.isdir(os.path.join(old_codex, "sessions")):
                out.append(["legacy", "codex", old_codex, codex_identity(old_codex), None])
    for row in out:
        label, tool, d, email, _ = row
        if email and email in EXCLUDED_EMAILS and not include_excluded:
            row[4] = "excluded account (%s)" % email
        elif not has_data(tool, d):
            signed = (os.path.exists(os.path.join(d, "auth.json")) if tool == "codex"
                      else bool(keychain_token(d)))
            row[4] = ("signed in \u2014 no usage recorded yet"
                      if signed else "not signed in yet")
    return out


def has_data(tool, d):
    """Cheap pre-check so an empty profile reports plainly instead of
    surfacing ccusage's raw CliError."""
    probe = os.path.join(d, "projects" if tool == "claude" else "sessions")
    if not os.path.isdir(probe):
        return False
    for _root, _dirs, files in os.walk(probe):
        if any(f.endswith(".jsonl") for f in files):
            return True
    return False


def run_one(entry, period, since, until):
    label, tool, d, email, skip = entry
    if skip:
        out = {"label": label, "tool": tool, "email": email, "skipped": skip}
        if tool == "codex":
            out["plan"] = codex_plan(d)
        return out
    env = dict(os.environ)
    env[ENV_VAR[tool]] = d
    cmd = ccusage_cmd() + [tool, period, "--json"]
    if since:
        cmd += ["--since", since]
    if until:
        cmd += ["--until", until]
    try:
        p = subprocess.run(cmd, env=env, capture_output=True, text=True, timeout=900)
    except subprocess.TimeoutExpired:
        return {"label": label, "tool": tool, "email": email, "skipped": "timed out"}
    if p.returncode != 0:
        msg = (p.stderr or p.stdout or "").strip().splitlines()
        return {"label": label, "tool": tool, "email": email,
                "skipped": msg[-1][:80] if msg else "ccusage exit %d" % p.returncode}
    try:
        doc = json.loads(p.stdout)
    except json.JSONDecodeError:
        return {"label": label, "tool": tool, "email": email, "skipped": "unparseable JSON"}
    totals = doc.get("totals") or {}
    series = []
    for row in (doc.get("daily") or doc.get("weekly") or doc.get("monthly") or []):
        if not isinstance(row, dict) or not row.get("date"):
            continue
        series.append({
            "date": row["date"],
            "tokens": row.get("totalTokens", 0) or 0,
            # same Claude/Codex key split as the totals block
            "cost": row.get("totalCost") or row.get("costUSD") or 0.0,
        })
    series.sort(key=lambda r: r["date"])
    return {
        "label": label, "tool": tool, "email": email, "dir": d,
        "tokens": totals.get("totalTokens", 0) or 0,
        # Claude reports cost as `totalCost`, Codex as `costUSD`. Same meaning,
        # different key — reading only the first silently zeroes every Codex row.
        "cost": totals.get("totalCost") or totals.get("costUSD") or 0.0,
        "reasoning": totals.get("reasoningOutputTokens", 0) or 0,
        "input": totals.get("inputTokens", 0) or 0,
        "output": totals.get("outputTokens", 0) or 0,
        "cacheRead": totals.get("cacheReadTokens", 0) or 0,
        "cacheWrite": totals.get("cacheCreationTokens", 0) or 0,
        "series": series,
        "limits": limits_for(tool, d),
    }


def human(n):
    for unit, div in (("B", 1e9), ("M", 1e6), ("K", 1e3)):
        if n >= div:
            return "%.1f%s" % (n / div, unit)
    return str(int(n))


