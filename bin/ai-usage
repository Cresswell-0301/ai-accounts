<script>
let DATA = __DATA__, META = __META__;
const $ = id => document.getElementById(id);
const colour = w => (w.severity === "critical" || w.pct >= 90) ? "var(--bad)"
                  : (w.severity === "warning" || w.pct >= 70) ? "var(--warn)" : "var(--ok)";

function when(ts, inferred) {
  if (inferred && String(inferred).indexOf("window reset") === 0) return "reset \u00b7 full";
  if (!ts) return "\u2014";
  const d = new Date(ts * 1000), ms = ts * 1000 - Date.now();
  if (ms <= 0) return "elapsed";
  const h = Math.floor(ms / 3.6e6), m = Math.floor(ms % 3.6e6 / 6e4);
  return ms < 864e5
    ? d.toLocaleTimeString([], {hour:"2-digit", minute:"2-digit"}) + " \u00b7 " + (h ? h + "h" + String(m).padStart(2,"0") : m + "m")
    : d.toLocaleDateString([], {weekday:"short", day:"numeric", month:"short"});
}

function cell(w) {
  if (!w) return '<td class="n" style="color:var(--mut)">\u2014</td>';
  const bang = (w.severity === "critical" || w.pct >= 90) ? '<span class="warnbadge">!</span>' : "";
  return `<td class="n"><span class="pct" style="color:${colour(w)}">${Math.round(w.pct)}%</span>${bang}
    <div class="meter"><i style="width:${Math.max(w.pct,2)}%;background:${colour(w)}"></i></div></td>`;
}

function sectionSync(rows) {
  // The OLDEST reading among HEALTHY rows: a healthy account that has quietly
  // gone stale still shows here. Rows with an error (blocked, expired) are
  // already labelled on their own line, so they are counted, not averaged in -
  // otherwise one blocked account makes the whole section look 18h stale.
  const healthy = rows.filter(r => r.limits && (r.limits.windows || []).length
                                   && r.limits.as_of && !r.limits.error);
  const failing = rows.filter(r => r.limits && r.limits.error).length;
  const ts = healthy.map(r => r.limits.as_of);
  if (!ts.length) return failing ? failing + " not reporting" : "";
  const t = Math.min.apply(null, ts);
  const d = new Date(t * 1000);
  const mins = Math.max(0, Math.floor((Date.now() - t * 1000) / 60000));
  const rel = mins < 1 ? "just now" : mins < 60 ? mins + "m ago"
            : mins < 1440 ? Math.floor(mins / 60) + "h ago" : Math.floor(mins / 1440) + "d ago";
  const clock = mins < 1440
    ? d.toLocaleTimeString([], {hour: "2-digit", minute: "2-digit"})
    : d.toLocaleDateString([], {weekday: "short", day: "numeric", month: "short"});
  return "Synced " + clock + " \u00b7 " + rel +
    (failing ? " \u00b7 " + failing + " not reporting" : "");
}

function relDays(ts) {
  if (!ts) return "";
  const ms = ts * 1000 - Date.now();
  if (ms <= 0 || ms < 864e5) return "";
  const d = Math.max(1, Math.round(ms / 864e5));
  return '<div class="mut">in ' + d + (d === 1 ? " day" : " days") + "</div>";
}

function rtime(w, kind) {
  // A window at 0% is not running, so it has no countdown; one at 100% is the
  // thing you are actually waiting on.
  if (!w) return '<span style="color:var(--mut)">\u2014</span>';
  if (!w.resets) {
    return '<span style="color:var(--mut)">' +
      (kind === "session" ? "no active session" : "\u2014") + '</span>';
  }
  const txt = when(w.resets, w.inferred);
  const rel = relDays(w.resets);
  return (w.pct >= 100 ? `<b>${txt}</b>` : txt) + rel;
}

function actions(r) {
  const signed = !!r.email;
  return `<td style="text-align:right;white-space:nowrap">
    <button class="icon" data-tool="${r.tool}" data-name="${r.label}"
      title="${signed ? "Re-sign in" : "Sign in"} ${r.label}"
      aria-label="${signed ? "Re-sign in" : "Sign in"} ${r.label}">${SIGNIN}</button>
    <button class="icon danger" title="Remove ${r.label}" aria-label="Remove ${r.label}"
      data-del-tool="${r.tool}" data-del-name="${r.label}">${TRASH}</button>
    <div class="authlink" id="lk-${r.tool}-${r.label}"></div></td>`;
}

const SIGNIN = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" ' +
  'stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
  '<path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>' +
  '<path d="M10 17l5-5-5-5"/><path d="M15 12H3"/></svg>';

const TRASH = '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" ' +
  'stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">' +
  '<path d="M3 6h18"/><path d="M8 6V4h8v2"/><path d="M6 6l1 14h10l1-14"/>' +
  '<path d="M10 11v6"/><path d="M14 11v6"/></svg>';

const find = (wins, kind) => (wins || []).find(w => w.kind === kind);

function render() {
  $("sub").innerHTML = META.live ? '<span class="dot"></span>Live' : "generated " + META.generated;

  const cc = DATA.filter(r => r.tool === "claude");
  $("cc").innerHTML = cc.length ? cc.map(r => {
    const wins = (r.limits && r.limits.windows) || [];
    if (!wins.length) {
      const why = (r.limits && r.limits.error) || r.skipped || "no data";
      return `<tr><td class="acct">${r.label}<small>${r.email || ""}</small></td>
        <td colspan="5" class="msg">${why}</td>${actions(r)}</tr>`;
    }
    const sess = find(wins, "session"), week = find(wins, "weekly_all"),
          fab = wins.find(w => w.kind === "weekly_scoped");
    return `<tr><td class="acct">${r.label}<small>${r.email || ""}</small></td>
      ${cell(sess)}<td class="renew">${rtime(sess, "session")}</td>
      ${cell(week)}<td class="renew">${rtime(week, "weekly")}</td>
      ${cell(fab)}${actions(r)}</tr>`;
  }).join("") : '<tr><td colspan="6" class="empty">No Claude accounts configured.</td></tr>';

  $("ccsync").textContent = sectionSync(cc);
  const cx = DATA.filter(r => r.tool === "codex");
  $("cxsync").textContent = sectionSync(cx);
  $("cx").innerHTML = cx.length ? cx.map(r => {
    const wins = (r.limits && r.limits.windows) || [];
    const plan = r.plan || (r.limits && r.limits.plan) || "";
    const head = `<td class="acct">${r.label}<small>${r.email || ""}${plan ? " \u00b7 " + plan : ""}</small></td>`;
    if (!wins.length) {
      const why = (r.limits && r.limits.error) || r.skipped || "no data";
      return `<tr>${head}<td colspan="2" class="msg">${why}</td>${actions(r)}</tr>`;
    }
    const w = wins[0];
    const extra = wins.length > 1
      ? '<div class="mut">' + wins.slice(1).map(x =>
          x.label + " " + Math.round(x.pct) + "%").join(" \u00b7 ") + "</div>"
      : "";
    return `<tr>${head}${cell(w)}
      <td class="renew"><b>${when(w.resets, w.inferred)}</b>${relDays(w.resets)}${extra}</td>
      ${actions(r)}</tr>`;
  }).join("") : '<tr><td colspan="4" class="empty">No Codex accounts configured.</td></tr>';

  wireRows();
}

function wireRows() {
  if (!document.querySelectorAll) return;
  document.querySelectorAll("button[data-tool]").forEach(b => {
    b.onclick = () => signIn(b.dataset.tool, b.dataset.name, b);
  });
  document.querySelectorAll("button[data-del-tool]").forEach(b => {
    b.onclick = () => removeAccount(b.dataset.delTool, b.dataset.delName, b);
  });
}

async function removeAccount(tool, name, btn) {
  const msg = "Remove " + name + " (" + tool + ")? This deletes its folder, its usage history and, for Claude, its saved credential. You would need to sign in again.";
  if (!confirm(msg)) return;
  btn.disabled = true; btn.title = "removing...";
  const res = await post("/api/remove", {tool, name});
  if (!res.ok) {
    btn.disabled = false; btn.title = "Remove " + name;
    alert("Could not remove: " + (res.error || "unknown error"));
    return;
  }
  await tick();
}

async function post(path, body) {
  const r = await fetch(path, {method:"POST", headers:{"Content-Type":"application/json"},
                              body: JSON.stringify(body)});
  return r.json();
}

async function signIn(tool, name, btn) {
  const slot = $("lk-" + tool + "-" + name);
  btn.disabled = true; btn.title = "starting sign-in...";
  const res = await post("/api/login", {tool, name, email: ""});
  if (!res.url) {
    slot.innerHTML = '<span class="bad">' + (res.error || "could not start") + "</span>";
    btn.disabled = false; btn.title = "Sign in " + name; return;
  }
  const win = window.open(res.url, "_blank", "noopener");
  codeBox(tool, name, slot,
    '<a href="' + res.url + '" target="_blank" rel="noopener">Open sign-in page</a>' +
    (win ? "" : ' <span class="bad">(popup blocked)</span>') +
    '<div class="mut">use a private window</div>');
  btn.title = "waiting for the browser...";
  waitForLogin(tool, name, slot, () => {
    btn.disabled = false; btn.title = "Re-sign in " + name;
  });
}

function nameFromEmail(email) {
  // The folder name is derived from the local part, normalised to what the
  // server accepts: start alphanumeric, then letters/digits/_/- only.
  const local = String(email || "").split("@")[0].toLowerCase();
  let n = local.replace(/[^a-z0-9_-]+/g, "-").replace(/^[-_]+|[-_]+$/g, "").slice(0, 32);
  if (n && !/^[a-z0-9]/.test(n)) n = n.slice(1);
  return n;
}

function updatePreview() {
  const email = $("nemail").value.trim();
  const n = nameFromEmail(email);
  $("nname").value = n;
  $("npreview").innerHTML = email
    ? (n ? 'account name: <strong>' + n + "</strong>"
         : '<span class="bad">that email has no usable name</span>')
    : "";
}

function openModal(on, tool) {
  $("modal").hidden = !on;
  if (!on) return;
  $("accnote").innerHTML = ""; $("nname").value = ""; $("nemail").value = "";
  $("npreview").innerHTML = "";
  if (tool) $("ntool").value = tool;          // pre-fill from the card you clicked
  const e = $("nemail"); if (e && e.focus) e.focus();
}

function codeBox(tool, name, slot, extraHtml) {
  const id = "code-" + tool + "-" + name;
  slot.innerHTML = extraHtml +
    '<div class="codebox">' +
    '<input id="' + id + '" placeholder="paste the code from the sign-in page" autocomplete="off">' +
    '<button id="' + id + '-go" class="small primary">Submit</button>' +
    '</div><div class="mut" id="' + id + '-msg">Signed in on another device? Paste its code here.</div>';
  const go = $(id + "-go"), inp = $(id), msg = $(id + "-msg");
  const send = async () => {
    const code = inp.value.trim();
    if (!code) return;
    go.disabled = true; msg.textContent = "submitting...";
    const res = await post("/api/login-code", {tool, name, code});
    go.disabled = false;
    msg.innerHTML = res.ok
      ? '<span class="ok">code accepted - finishing sign-in...</span>'
      : '<span class="bad">' + res.error + "</span>";
  };
  if (go) go.onclick = send;
  if (inp) inp.onkeydown = e => { if (e.key === "Enter") send(); };
}

async function syncSection(tool, btn) {
  btn.disabled = true; btn.classList.add("spinning");
  try {
    await post("/api/sync", {tool});
    const r = await fetch("data.json", {cache: "no-store"});
    const j = await r.json();
    DATA = j.rows; META = j.meta; render();
  } catch (e) {}
  btn.classList.remove("spinning");
  setTimeout(() => { btn.disabled = false; }, 5000);
}

function waitForLogin(tool, name, slot, onDone) {
  const started = Date.now();
  const poll = setInterval(async () => {
    const st = await post("/api/login-state", {tool, name});
    if (st.signedIn) {
      clearInterval(poll);
      slot.innerHTML = '<span class="ok">signed in as ' + (st.email || "") + "</span>";
      await tick();
      if (onDone) onDone(true, st);
    } else if (st.error || Date.now() - started > 300000) {
      clearInterval(poll);
      slot.innerHTML = '<span class="bad">' + (st.error || "timed out") + "</span>";
      if (onDone) onDone(false, st);
    }
  }, 3000);
}

async function addAccount() {
  const tool = $("ntool").value;
  const email = $("nemail").value.trim();
  if (!email || email.indexOf("@") < 1) {
    $("accnote").innerHTML = '<span class="bad">enter an email address</span>'; return;
  }
  const name = nameFromEmail(email);
  if (!name) {
    $("accnote").innerHTML = '<span class="bad">could not derive a name from that email</span>'; return;
  }
  const b = $("addbtn"); b.disabled = true;
  const res = await post("/api/add", {tool, name});
  if (!res.ok) {
    b.disabled = false;
    $("accnote").innerHTML = '<span class="bad">' + res.error + "</span>"; return;
  }

  // One shot: created, now start the sign-in and send them straight to it.
  $("accnote").innerHTML = '<span class="mut">created ' + name + " - starting sign-in...</span>";
  const lg = await post("/api/login", {tool, name, email});
  b.disabled = false;
  await tick();

  if (!lg.url) {
    $("accnote").innerHTML = '<span class="bad">created, but sign-in did not start: ' +
      (lg.error || "no URL") + "</span>";
    return;
  }
  const win = window.open(lg.url, "_blank", "noopener");
  codeBox(tool, name, $("accnote"),
    '<a href="' + lg.url + '" target="_blank" rel="noopener">Open sign-in page</a>' +
    (win ? ' <span class="mut">(opened in a new tab)</span>'
         : ' <span class="bad">(popup blocked - click the link)</span>') +
    '<div class="mut">Use a private window, or it will authorize whoever is already signed in.</div>');
  b.textContent = "waiting...";
  b.disabled = true;
  waitForLogin(tool, name, $("accnote"), (ok) => {
    b.disabled = false; b.textContent = "Add";
    if (ok) setTimeout(() => openModal(false), 1200);
  });
}

function wireUI() {
  const sync = $("sync");
  if (sync) sync.onclick = async () => {
    sync.disabled = true; sync.textContent = "syncing...";
    try {
      // Codex can only be refreshed by running each account, which takes a few
      // seconds; do that first, then pull the fresh numbers for everything.
      await post("/api/sync", {});
      const r = await fetch("data.json?force=1", {cache: "no-store"});
      const j = await r.json();
      DATA = j.rows; META = j.meta; render();
    } catch (e) {}
    sync.textContent = "Sync now";
    // brief cooldown: a forced sync bypasses the per-account poll floor
    setTimeout(() => { sync.disabled = false; }, 15000);
  };
  const open = $("openadd"); if (open) open.onclick = () => openModal(true);
  if (document.querySelectorAll) {
    document.querySelectorAll("button[data-sync]").forEach(b => {
      b.onclick = () => syncSection(b.dataset.sync, b);
    });
    document.querySelectorAll("button[data-add]").forEach(b => {
      b.onclick = () => openModal(true, b.dataset.add);
